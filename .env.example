# Production: Set NEXT_PUBLIC_APP_URL to your live origin (e.g. https://your-app.vercel.app).
# For password reset emails via Resend: Supabase Dashboard → Project Settings → Auth
# → SMTP (use Resend: host smtp.resend.com, RESEND_API_KEY, from address as Resend allows).
# For declaration file uploads: apply supabase/migrations/20260513000000_entry_uploads_storage.sql (Storage bucket entry-uploads).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=
RESEND_API_KEY=
CRON_SECRET=generate-a-long-random-string
