# Public site URL (optional) for links/emails (NEXT_PUBLIC_APP_URL). Not used for OAuth redirect origin
# (OAuth always uses the current browser host so PKCE cookies match).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: Set NEXT_PUBLIC_APP_URL to your live origin (emails, share links). Often same as NEXT_PUBLIC_SITE_URL.
# For password reset emails via Resend: Supabase Dashboard → Project Settings → Auth
# → SMTP (use Resend: host smtp.resend.com, RESEND_API_KEY, from address as Resend allows).
# For declaration file uploads: apply supabase/migrations/20260513000000_entry_uploads_storage.sql (Storage bucket entry-uploads).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Production (custom domain with www + apex): set on Vercel to fix PKCE / flow-state cookie mismatch.
# Also helps Android/iPhone when stale sb-* cookies accumulate — users can “Clear site sign-in cookies” on /login.
# Example value: .oxecute.com — leave UNSET for localhost http://localhost:3000
# NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.oxecute.com
# Optional (HTTPS prod only): if phones still show PKCE errors after Google, try:
# NEXT_PUBLIC_SUPABASE_COOKIE_SAMESITE=none
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=
RESEND_API_KEY=
CRON_SECRET=generate-a-long-random-string
# Optional: set to 1 on Vercel to log auth flow (server + client) — remove after debugging.
# AUTH_DEBUG=1
# NEXT_PUBLIC_AUTH_DEBUG=1
